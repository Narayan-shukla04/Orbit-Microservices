# ─── Google Cloud Run Environment Variables File ───────────────────────────
# Copy this file to env.yaml and fill in your values:
# cp env.yaml.example env.yaml
#
# Usage with gcloud CLI:
# gcloud run deploy <service-name> --env-vars-file=env.yaml ...

NODE_ENV: "production"

# Database Connection Strings (MongoDB Atlas + Upstash Redis)
MONGO_URI: "mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/discord?retryWrites=true&w=majority"
REDIS_URL: "rediss://default:<password>@<endpoint>.upstash.io:6379"

# Security
JWT_SECRET: "your-strong-random-64-character-jwt-secret"

# Voice & Video (LiveKit Cloud)
LIVEKIT_URL: "wss://your-project.livekit.cloud"
LIVEKIT_API_KEY: "your_livekit_api_key"
LIVEKIT_API_SECRET: "your_livekit_api_secret"

# Media Storage (ImageKit.io)
IK_PUB_KEY: "public_xxxxxxxxxxxxxxxx"
IK_PRIV_KEY: "private_xxxxxxxxxxxxxxx"
IK_URL_END_POINT: "https://ik.imagekit.io/your_id"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""
GOOGLE_CALLBACK_URL: ""

# Email / SMTP for Password Resets (Optional)
EMAIL_USER: ""
EMAIL_PASS: ""
