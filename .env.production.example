# ─── Production Environment Variables Template ────────────────────────────
# Copy to .env.production and fill in real values

# General
NODE_ENV=production
CLIENT_URL=https://your-domain.com
JWT_SECRET=generate-a-strong-random-64-char-secret-here

# Databases (Managed Cloud: MongoDB Atlas + Upstash Redis)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/discord?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# LiveKit (Voice & Video)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ImageKit (Avatar & Image Uploads)
IK_PUB_KEY=public_xxxxxxxxxxxxxxxx
IK_PRIV_KEY=private_xxxxxxxxxxxxxxx
IK_URL_END_POINT=https://ik.imagekit.io/your_id

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api-gateway.com/api/auth/google/callback

# SMTP / Email for Password Reset (Optional)
EMAIL_USER=
EMAIL_PASS=
